{
  "name": "takomi",
  "version": "2.5.14",
  "description": "🎯 Stop wrestling with AI. Start building with purpose. The artisan's toolkit for agent workflows, Codex skills, and original Takomi capabilities like 21st.dev integration.",
  "type": "module",
  "bin": {
    "takomi": "bin/takomi.js"
  },
  "files": [
    ".agents/plugins",
    "bin",
    "src",
    "assets",
    "plugins/takomi-codex",
    "plugins/takomi-flow/.codex-plugin",
    "plugins/takomi-flow/.mcp.json",
    "plugins/takomi-flow/assets",
    "plugins/takomi-flow/package.json",
    "plugins/takomi-flow/pnpm-lock.yaml",
    "plugins/takomi-flow/references",
    "plugins/takomi-flow/scripts",
    "plugins/takomi-flow/skills",
    "docs/takomi-flow-onboarding.md",
    "docs/takomi-flow-public-distribution.md",
    "docs/features/TakomiFlow_Portable_Plugin.md",
    ".agents/plugins/marketplace.json",
    "scripts/install-takomi-flow.ps1",
    ".pi/README.md",
    ".pi/agents",
    ".pi/extensions",
    ".pi/prompts",
    ".pi/themes",
    ".pi/settings.json",
    ".pi/takomi-profile.json",
    ".pi/takomi/context-manager",
    ".pi/takomi/model-routing.md",
    ".pi/takomi/policies"
  ],
  "scripts": {
    "postinstall": "node src/postinstall.js",
    "test": "npm run test:typecheck && npm run test:regressions && npm run test:context-manager && npm run test:skills",
    "test:typecheck": "tsc --noEmit",
    "test:regressions": "node scripts/test-regressions.js && node scripts/test-subagent-renderers.js && node scripts/test-subagent-heartbeat.js && node scripts/test-subagent-production-lifecycle.js && node scripts/test-subagent-acceptance.js && node scripts/test-takomi-runtime-renderers.js && node scripts/test-workflow-catalog.js && node scripts/test-oauth-router-report-ui.js && node --experimental-specifier-resolution=node scripts/test-takomi-board-errors.js && node scripts/test-takomi-gate-provenance.js && node scripts/test-takomi-routing-safety.js && node scripts/test-subagent-project-trust.js && node scripts/test-antigravity-provider.js",
    "test:context-manager": "node --experimental-specifier-resolution=node scripts/test-context-manager-renderers.js",
    "test:skills": "node scripts/test-skill-selection.js",
    "takomi-flow:doctor": "node plugins/takomi-flow/scripts/takomi-flow.mjs doctor",
    "takomi-flow:selftest": "node plugins/takomi-flow/scripts/takomi-flow.mjs selftest",
    "takomi-flow:mcp-smoke": "node plugins/takomi-flow/scripts/mcp-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JStaRFilms/VibeCode-Protocol-Suite.git"
  },
  "keywords": [
    "takomi",
    "ai",
    "skills",
    "codex",
    "agentic",
    "21st.dev",
    "vibecode",
    "cursor",
    "windsurf",
    "protocols"
  ],
  "author": "J StaR Films Studios",
  "license": "ISC",
  "dependencies": {
    "commander": "^13.1.0",
    "figlet": "^1.8.0",
    "fs-extra": "^11.3.0",
    "pi-subagents": "0.31.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "@protobufjs/utf8": "1.1.1",
    "ws": "8.21.0",
    "brace-expansion": "5.0.6"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "7.6.3",
      "@protobufjs/utf8": "1.1.1",
      "ws": "8.21.0",
